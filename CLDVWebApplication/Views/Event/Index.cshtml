@model IEnumerable<CLDVWebApplication.Models.EventTable>

@{
    ViewData["Title"] = "Events";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<h1>Events</h1>

<!-- Filter Form -->
<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-3">
            <label>Event Type</label>
            <select name="searchType" class="form-control">
                <option value="">-- All Types --</option>
                @foreach (var type in (List<CLDVWebApplication.Models.EventType>)ViewData["EventTypes"])
                {
                    <option value="@type.Name" selected="@(Context.Request.Query["searchType"] == type.Name)">@type.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>Venue</label>
            <select name="venueId" class="form-control">
                <option value="">-- All Venues --</option>
                @foreach (var venue in (List<CLDVWebApplication.Models.Venue>)ViewData["Venues"])
                {
                    <option value="@venue.VenueId" selected="@(Context.Request.Query["venueId"] == venue.VenueId.ToString())">@venue.VenueName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>From Date</label>
            <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]" />
        </div>
        <div class="col-md-3">
            <label>To Date</label>
            <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]" />
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Venue)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EventName)
                </td>
                <td>
                    @item.EventDate.ToString("yyyy-MM-dd HH:mm")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Venue.VenueName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EventId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EventId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>